<?xml version="1.0" encoding="utf-8"?>
<Mod id="37b6e9ff-22b6-4b34-b1db-78f55d61aa2a" version="0.1">
  <Properties>
    <Name>Obelisk</Name>
    <Teaser>Quiet in-game AI assistant overlay prototype for Civilization VI.</Teaser>
    <Description>Initial in-game UI context prototype for Obelisk.</Description>
    <Authors>zyfay518, Codex</Authors>
    <CompatibleVersions>1.2,2.0</CompatibleVersions>
  </Properties>
  <InGameActions>
    <AddUserInterfaces id="ObeliskInGameUI">
      <Properties>
        <Context>InGame</Context>
      </Properties>
      <File>UI/Obelisk.xml</File>
    </AddUserInterfaces>
  </InGameActions>
  <Files>
    <File>UI/Obelisk.xml</File>
    <File>UI/Obelisk.lua</File>
  </Files>
</Mod>
